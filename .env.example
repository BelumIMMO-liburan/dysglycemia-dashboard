# ==============================================================================
# Environment Configuration Template
# Decision Dashboard for Non-Laboratory Dysglycemia Screening
# ==============================================================================

# Application Operational Mode:
# 'evaluation'   - Public / Participant evaluation study (Railway deployment)
# 'feedback_lab' - Researcher feedback learning laboratory (Localhost)
APP_MODE=evaluation

# Django Security Settings
# Generate a strong secret key for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-production-secret-key-here-do-not-commit-real-key

# Debug Mode: False in production, True for local development
DEBUG=False

# Database Configuration
# In Railway with PostgreSQL plugin/service, DATABASE_URL is set automatically:
# DATABASE_URL=postgresql://postgres:password@roundhouse.proxy.rlwy.net:5432/railway
# If DATABASE_URL is omitted, Django defaults to SQLite (db_evaluation.sqlite3 or /data/db_evaluation.sqlite3)
# DATABASE_URL=

# Researcher Access Key (Protects /evaluation/analytics/ and /evaluation/export/ in evaluation mode)
# RESEARCHER_ACCESS_KEY=your-secure-32-char-key-here

# Hostname Configuration (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app

# CSRF Trusted Origins (comma-separated, include scheme)
CSRF_TRUSTED_ORIGINS=https://*.railway.app,http://localhost,http://127.0.0.1
